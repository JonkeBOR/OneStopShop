{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestopshop",
  "account_id": "2c9deedd46d8135271fef57c6854e55c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "onestopshop",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onestopshop",
      "database_id": "0bb2542d-a2e1-48da-9530-1aaafcea0fe7",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "598266239301-g3q2rnvvqg31kldgulglp3fp80gkmi6i.apps.googleusercontent.com",
    "OWNER_EMAIL": "jonknu92@gmail.com",
  },
}
