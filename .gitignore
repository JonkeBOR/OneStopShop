## .gitignore for a Next.js / TypeScript project.
## See https://github.com/github/gitignore/blob/main/Node.gitignore for the upstream template.

# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts

# Production/deployment
.vercel/
.wrangler/
.open-next/

# Environment variables and secrets
.env
.env*.local
*.pem
credentials.json
service-account*.json
client_secret_*.json

# Testing and coverage
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/
.vitest/

# Caches
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
*~

# Local HTTPS certificates
certificates/

# Local agent configuration
.claude/settings.local.json
