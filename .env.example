# OAuth client id, from the Google Cloud console.
GOOGLE_CLIENT_ID=

# OAuth client secret, from the Google Cloud console.
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered on the OAuth client exactly, including scheme and port.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
SESSION_SECRET=

# The service account's client_email, from its downloaded JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private_key, from the same JSON key file. Multi-line PEM: store with
# literal \n sequences, which env.ts converts back to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The id of the Google Sheet, from its URL between /d/ and /edit.
GOOGLE_SHEET_ID=

# The one Google account permitted to use the app.
ALLOWED_GOOGLE_EMAIL=

# IANA timezone name, e.g. Europe/Oslo. Decides what "today" means for a measurement.
APP_TIME_ZONE=
